<Window x:Class="FeatherView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FeatherView.Controls"
        xmlns:v="clr-namespace:FeatherView.Views"
        xmlns:s="clr-namespace:FeatherView.Services"
        Title="Feather View" Icon="pack://application:,,,/Assets/app.ico" Width="1280" Height="800" MinWidth="980" MinHeight="520"
        Background="{DynamicResource BgBrush}" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="40" ResizeBorderThickness="6" GlassFrameThickness="0" CornerRadius="0" UseAeroCaptionButtons="False" />
    </WindowChrome.WindowChrome>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <s:EnumEqualsConverter x:Key="EnumEq" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Left" Modifiers="Shift" Command="{Binding ExtendSelectionCommand}" CommandParameter="L" />
        <KeyBinding Key="Right" Modifiers="Shift" Command="{Binding ExtendSelectionCommand}" CommandParameter="R" />
        <KeyBinding Key="Up" Modifiers="Shift" Command="{Binding ExtendSelectionCommand}" CommandParameter="U" />
        <KeyBinding Key="Down" Modifiers="Shift" Command="{Binding ExtendSelectionCommand}" CommandParameter="D" />
        <KeyBinding Key="Home" Modifiers="Shift" Command="{Binding ExtendSelectionCommand}" CommandParameter="H" />
        <KeyBinding Key="End" Modifiers="Shift" Command="{Binding ExtendSelectionCommand}" CommandParameter="E" />
        <KeyBinding Key="Up" Modifiers="Ctrl" Command="{Binding MoveCursorCommand}" CommandParameter="U" />
        <KeyBinding Key="Down" Modifiers="Ctrl" Command="{Binding MoveCursorCommand}" CommandParameter="D" />
        <KeyBinding Key="Space" Modifiers="Ctrl" Command="{Binding ToggleCursorCheckedCommand}" />
        <KeyBinding Key="Right" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Command="{Binding PrevCommand}" />
        <KeyBinding Key="Down" Command="{Binding DownCommand}" />
        <KeyBinding Key="Up" Command="{Binding UpCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextFileCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PrevFileCommand}" />
        <KeyBinding Key="Space" Command="{Binding SpaceCommand}" />
        <KeyBinding Key="Back" Command="{Binding PrevCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding SeekLongBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding SeekLongForwardCommand}" />
        <KeyBinding Key="OemComma" Command="{Binding Video.FrameBackCommand}" />
        <KeyBinding Key="OemPeriod" Command="{Binding Video.FrameForwardCommand}" />
        <KeyBinding Key="OemOpenBrackets" Command="{Binding Video.SpeedDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Command="{Binding Video.SpeedUpCommand}" />
        <KeyBinding Key="M" Command="{Binding Video.MuteCommand}" />
        <KeyBinding Key="A" Command="{Binding Video.AbLoopCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Video.ScreenshotCommand}" />
        <KeyBinding Key="J" Modifiers="Ctrl" Command="{Binding Video.GoToTimeCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding Tabs.NewTabCommand}" />
        <KeyBinding Key="W" Modifiers="Ctrl" Command="{Binding Tabs.CloseTabCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl+Shift" Command="{Binding Tabs.ReopenTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Ctrl" Command="{Binding Tabs.NextTabCommand}" />
        <KeyBinding Key="Tab" Modifiers="Ctrl+Shift" Command="{Binding Tabs.PreviousTabCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding Video.LoopCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Ctrl" Command="{Binding Video.ChapterNextCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Ctrl" Command="{Binding Video.ChapterPreviousCommand}" />
        <KeyBinding Key="Home" Command="{Binding FirstCommand}" />
        <KeyBinding Key="End" Command="{Binding LastCommand}" />
        <KeyBinding Key="Return" Command="{Binding OpenSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}" />
        <KeyBinding Key="F" Command="{Binding ToggleFullscreenCommand}" />
        <KeyBinding Key="G" Command="{Binding ToggleGalleryCommand}" />
        <KeyBinding Key="S" Command="{Binding ToggleSlideshowCommand}" />
        <KeyBinding Key="I" Command="{Binding ToggleInfoCommand}" />
        <KeyBinding Key="R" Command="{Binding RotateRightCommand}" />
        <KeyBinding Key="R" Modifiers="Shift" Command="{Binding RotateLeftCommand}" />
        <KeyBinding Key="L" Command="{Binding RotateLeftCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="A" Modifiers="Ctrl" Command="{Binding SelectAllCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding SettingsCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Command="{Binding FitCommand}" />
        <KeyBinding Key="NumPad0" Command="{Binding FitCommand}" />
        <KeyBinding Key="D1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="NumPad1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="D" Modifiers="Ctrl" Command="{Binding ToggleFavoriteCommand}" />
        <KeyBinding Key="B" Modifiers="Ctrl" Command="{Binding ToggleSidebarCommand}" />
        <KeyBinding Key="T" Command="{Binding ToggleFilmstripCommand}" />
        <KeyBinding Key="P" Modifiers="Ctrl" Command="{Binding PrintCommand}" />
        <KeyBinding Key="F" Modifiers="Ctrl" Command="{Binding ShowSectionCommand}" CommandParameter="Search" />
    </Window.InputBindings>

    <Grid x:Name="RootGrid">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Title bar (dragging comes from WindowChrome.CaptionHeight) -->
        <Grid x:Name="TitleBar" Grid.Row="0" Height="40" Visibility="{Binding ShowChrome, Converter={StaticResource B2V}}" SizeChanged="TitleBar_SizeChanged">
            <StackPanel Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                <Image Source="pack://application:,,,/Assets/logo.png" Width="22" Height="22" RenderOptions.BitmapScalingMode="HighQuality" />
            </StackPanel>
            <StackPanel x:Name="TabStrip" Orientation="Horizontal" Margin="52,0,150,0" VerticalAlignment="Center" HorizontalAlignment="Left" WindowChrome.IsHitTestVisibleInChrome="True">
                <ItemsControl ItemsSource="{Binding Tabs.Items}">
                    <ItemsControl.ItemsPanel><ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border x:Name="Chip" Width="{Binding DataContext.Tabs.TabWidth, RelativeSource={RelativeSource AncestorType=Window}}" Height="30" Margin="2,0" Padding="12,0,4,0"
                                    CornerRadius="8" Background="Transparent" ToolTip="{Binding Title}"
                                    MouseLeftButtonDown="Tab_MouseLeftButtonDown" MouseDown="Tab_MouseDown" MouseRightButtonUp="Tab_MouseRightButtonUp">
                                <DockPanel>
                                    <Button DockPanel.Dock="Right" Style="{StaticResource TinyCloseButton}" Tag="{StaticResource IconClose}" ToolTip="Close tab (Ctrl+W)" Click="TabClose_Click" AutomationProperties.Name="Close tab" />
                                    <Viewbox DockPanel.Dock="Left" Width="13" Height="13" Margin="0,0,6,0" Visibility="{Binding IsPlaying, Converter={StaticResource B2V}}" ToolTip="A video is playing in this tab">
                                        <Canvas Width="24" Height="24"><Path Data="{StaticResource IconVolume}" Stroke="{DynamicResource AccentBrush}" StrokeThickness="2.4" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas>
                                    </Viewbox>
                                    <TextBlock Text="{Binding Title}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" x:Name="ChipText" />
                                </DockPanel>
                            </Border>
                            <DataTemplate.Triggers>
                                <Trigger SourceName="Chip" Property="IsMouseOver" Value="True"><Setter TargetName="Chip" Property="Background" Value="{DynamicResource HoverBrush}" /></Trigger>
                                <DataTrigger Binding="{Binding IsActive}" Value="True">
                                    <Setter TargetName="Chip" Property="Background" Value="{DynamicResource SurfaceBrush}" />
                                    <Setter TargetName="ChipText" Property="Foreground" Value="{DynamicResource TextBrush}" />
                                </DataTrigger>
                            </DataTemplate.Triggers>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPlus}" ToolTip="New tab (Ctrl+T)" Command="{Binding Tabs.NewTabCommand}" AutomationProperties.Name="New tab" Margin="4,0,0,0" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" WindowChrome.IsHitTestVisibleInChrome="True">
                <Button Style="{StaticResource CaptionButton}" Tag="{StaticResource CaptionMinimize}" ToolTip="Minimize" Click="Minimize_Click" AutomationProperties.Name="Minimize" />
                <Button x:Name="MaximizeButton" Style="{StaticResource CaptionButton}" Tag="{StaticResource CaptionMaximize}" ToolTip="Maximize" Click="Maximize_Click" AutomationProperties.Name="Maximize or restore" />
                <Button Style="{StaticResource CloseCaptionButton}" Tag="{StaticResource CaptionClose}" ToolTip="Close" Click="Close_Click" AutomationProperties.Name="Close" />
            </StackPanel>
        </Grid>

        <Grid x:Name="BodyGrid" Grid.Row="1" Margin="10,0,10,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <!-- Sidebar -->
            <StackPanel Grid.Column="0" Width="214" Margin="0,4,12,0">
                <StackPanel.Style>
                    <Style TargetType="StackPanel">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowSidebar}" Value="True" />
                                    <Condition Binding="{Binding ShowChrome}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </StackPanel.Style>
                    <Button Tag="{StaticResource IconGrid}" Content="Gallery" Command="{Binding ShowSectionCommand}" CommandParameter="Gallery" AutomationProperties.Name="Gallery">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Gallery">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconFolder}" Content="Folders" Command="{Binding ShowSectionCommand}" CommandParameter="Folders" AutomationProperties.Name="Folders">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Folders">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconStar}" Content="Favorites" Command="{Binding ShowSectionCommand}" CommandParameter="Favorites" AutomationProperties.Name="Favorites">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Favorites">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconClock}" Content="Recent" Command="{Binding ShowSectionCommand}" CommandParameter="Recent" AutomationProperties.Name="Recent">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Recent">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconSearch}" Content="Search" Command="{Binding ShowSectionCommand}" CommandParameter="Search" AutomationProperties.Name="Search">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Section}" Value="Search">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                <Rectangle Height="1" Fill="{DynamicResource BorderBrushSoft}" Margin="4,12,4,12" />
                <TextBlock Text="Quick Filters" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,0,6" FontSize="12" />
                    <Button Tag="{StaticResource IconImage}" Command="{Binding SetFilterCommand}" CommandParameter="All" AutomationProperties.Name="All Media filter">
                        <Button.Content>
                            <Grid><TextBlock Text="All Media" /><TextBlock Text="{Binding CountAll}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="All">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconImage}" Command="{Binding SetFilterCommand}" CommandParameter="Jpg" AutomationProperties.Name="JPG filter">
                        <Button.Content>
                            <Grid><TextBlock Text="JPG" /><TextBlock Text="{Binding CountJpg}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="Jpg">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconImage}" Command="{Binding SetFilterCommand}" CommandParameter="Png" AutomationProperties.Name="PNG filter">
                        <Button.Content>
                            <Grid><TextBlock Text="PNG" /><TextBlock Text="{Binding CountPng}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="Png">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconImage}" Command="{Binding SetFilterCommand}" CommandParameter="Gif" AutomationProperties.Name="GIF filter">
                        <Button.Content>
                            <Grid><TextBlock Text="GIF" /><TextBlock Text="{Binding CountGif}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="Gif">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconVideo}" Command="{Binding SetFilterCommand}" CommandParameter="Video" AutomationProperties.Name="Videos filter">
                        <Button.Content>
                            <Grid><TextBlock Text="Videos" /><TextBlock Text="{Binding CountVideo}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="Video">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Tag="{StaticResource IconFile}" Command="{Binding SetFilterCommand}" CommandParameter="Other" AutomationProperties.Name="Other filter">
                        <Button.Content>
                            <Grid><TextBlock Text="Other" /><TextBlock Text="{Binding CountOther}" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                        </Button.Content>
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource NavItem}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding Filter}" Value="Other">
                                        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
            </StackPanel>

            <!-- Content -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <Border Grid.Row="0" Margin="0,4,0,8" Padding="10,6" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding ShowSearch, Converter={StaticResource B2V}}">
                    <DockPanel>
                        <Button DockPanel.Dock="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}" ToolTip="Close search (Esc)" Command="{Binding ClearSearchCommand}" AutomationProperties.Name="Close search" />
                        <TextBox x:Name="SearchBox" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" FontSize="14" AutomationProperties.Name="Search file names" />
                    </DockPanel>
                </Border>

                <!-- Toolbar -->
                <Border Grid.Row="1" Margin="0,4,0,10" Padding="10,6" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding ShowChrome, Converter={StaticResource B2V}}">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPrev}" ToolTip="Previous (Left)" Command="{Binding PrevCommand}" AutomationProperties.Name="Previous (Left)" />
                            <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconNext}" ToolTip="Next (Right)" Command="{Binding NextCommand}" AutomationProperties.Name="Next (Right)" />
                            <Rectangle Width="1" Margin="10,6" Fill="{DynamicResource BorderBrushSoft}" />
                            <Button x:Name="ZoomButton" Style="{StaticResource TextButton}" Background="Transparent" Padding="8,4" MinWidth="0" Click="ZoomButton_Click" ToolTip="Zoom" AutomationProperties.Name="Zoom level">
                                <StackPanel Orientation="Horizontal">
                                    <Viewbox Width="17" Height="17"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconZoomIn}" Stroke="{DynamicResource TextBrush}" StrokeThickness="2" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" /></Canvas></Viewbox>
                                    <TextBlock Text="{Binding ZoomText}" Margin="10,0,6,0" MinWidth="38" VerticalAlignment="Center" />
                                    <Viewbox Width="12" Height="12"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconChevronDown}" Stroke="{DynamicResource SubtleTextBrush}" StrokeThickness="2.5" StrokeStartLineCap="Round" StrokeEndLineCap="Round" /></Canvas></Viewbox>
                                </StackPanel>
                            </Button>
                            <ToggleButton Style="{StaticResource IconToggle}" Foreground="{DynamicResource ToolGalleryBrush}" Tag="{StaticResource IconGrid}" ToolTip="Thumbnail gallery (G)" IsChecked="{Binding IsGallery, Mode=OneWay}" Command="{Binding ToggleGalleryCommand}" AutomationProperties.Name="Gallery" Margin="6,0,1,0" />
                            <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource BorderBrushSoft}" />
                            <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource ToolRotateBrush}" Tag="{StaticResource IconRotateLeft}" ToolTip="Rotate left (L)" Command="{Binding RotateLeftCommand}" AutomationProperties.Name="Rotate left" />
                            <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource ToolRotateBrush}" Tag="{StaticResource IconRotateRight}" ToolTip="Rotate right (R)" Command="{Binding RotateRightCommand}" AutomationProperties.Name="Rotate right" />
                            <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource ToolFlipBrush}" Tag="{StaticResource IconFlip}" ToolTip="Flip horizontally" Command="{Binding FlipCommand}" AutomationProperties.Name="Flip horizontally" />
                            <Button ToolTip="Slideshow (S)" Command="{Binding ToggleSlideshowCommand}" Margin="6,0,1,0" AutomationProperties.Name="Slideshow">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Foreground" Value="{DynamicResource ToolPlayBrush}" />
                                        <Setter Property="Tag" Value="{StaticResource IconPlay}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsSlideshow}" Value="True"><Setter Property="Tag" Value="{StaticResource IconPause}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                        </StackPanel>
                        <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="16,0" VerticalAlignment="Center" HorizontalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                        <StackPanel Grid.Column="2" Orientation="Horizontal">
                            <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource ToolCopyBrush}" Tag="{StaticResource IconCopy}" ToolTip="Copy image (Ctrl+C)" Command="{Binding CopyCommand}" AutomationProperties.Name="Copy" />
                            <Button Style="{StaticResource IconButton}" Foreground="{DynamicResource ToolDeleteBrush}" Tag="{StaticResource IconTrash}" ToolTip="Delete - moves to the Recycle Bin (Del)" Command="{Binding DeleteCommand}" AutomationProperties.Name="Delete" />
                            <Rectangle Width="1" Margin="8,6" Fill="{DynamicResource BorderBrushSoft}" />
                            <Button ToolTip="Favorite (Ctrl+D)" Command="{Binding ToggleFavoriteCommand}" AutomationProperties.Name="Favorite">
                                <Button.Style>
                                    <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                        <Setter Property="Tag" Value="{StaticResource IconStar}" />
                                        <Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsFavorite}" Value="True"><Setter Property="Foreground" Value="{DynamicResource ToolStarBrush}" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </Button.Style>
                            </Button>
                            <ToggleButton Style="{StaticResource IconToggle}" Foreground="{DynamicResource ToolInfoBrush}" Tag="{StaticResource IconInfo}" ToolTip="Details (I)" IsChecked="{Binding ShowInfo}" AutomationProperties.Name="Details panel" />
                            <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconMore}" ToolTip="More" Click="MoreButton_Click" AutomationProperties.Name="More options" />
                        </StackPanel>
                    </Grid>
                </Border>

                <!-- Media area -->
                <Border x:Name="MediaHost" Grid.Row="2" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" SizeChanged="MediaHost_SizeChanged">
                    <Grid>
                        <Grid x:Name="PhotoArea" Visibility="{Binding IsPhoto, Converter={StaticResource B2V}}">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                            <c:ZoomPanImage x:Name="Viewer" Source="{Binding CurrentImage}" ImageId="{Binding ImageId}" FitOnOpen="{Binding Settings.FitOnOpen}">
                                <c:ZoomPanImage.Style>
                                    <Style TargetType="c:ZoomPanImage">
                                        <Setter Property="Grid.ColumnSpan" Value="2" />
                                        <Style.Triggers><DataTrigger Binding="{Binding IsCompare}" Value="True"><Setter Property="Grid.ColumnSpan" Value="1" /></DataTrigger></Style.Triggers>
                                    </Style>
                                </c:ZoomPanImage.Style>
                            </c:ZoomPanImage>
                            <c:ZoomPanImage x:Name="Viewer2" Grid.Column="1" Source="{Binding CompareImage}" ImageId="{Binding CompareId}" FitOnOpen="True" Margin="3,0,0,0"
                                            Visibility="{Binding IsCompare, Converter={StaticResource B2V}}" />
                            <TextBlock Grid.Column="1" Text="{Binding CompareName}" Visibility="{Binding IsCompare, Converter={StaticResource B2V}}" Margin="16,0,0,12" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       Foreground="White" FontSize="12" Background="#99000000" Padding="8,3" />
                            <TextBlock Text="{Binding InfoTitle}" Visibility="{Binding IsCompare, Converter={StaticResource B2V}}" Margin="16,0,0,12" VerticalAlignment="Bottom" HorizontalAlignment="Left"
                                       Foreground="White" FontSize="12" Background="#99000000" Padding="8,3" />
                        </Grid>
                        <!-- Floating photo toolbar -->
                        <Border HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,12,12,0" Padding="4,3" CornerRadius="10" Background="{DynamicResource SurfaceBrush}" Opacity="0.96">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility" Value="Collapsed" />
                                    <Style.Triggers>
                                        <MultiDataTrigger>
                                            <MultiDataTrigger.Conditions>
                                                <Condition Binding="{Binding IsPhoto}" Value="True" />
                                                <Condition Binding="{Binding ShowChrome}" Value="True" />
                                            </MultiDataTrigger.Conditions>
                                            <Setter Property="Visibility" Value="Visible" />
                                        </MultiDataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <StackPanel Orientation="Horizontal">
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconZoomOut}" ToolTip="Zoom out (-)" Command="{Binding ZoomOutCommand}" AutomationProperties.Name="Zoom out (-)" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconZoomIn}" ToolTip="Zoom in (+)" Command="{Binding ZoomInCommand}" AutomationProperties.Name="Zoom in (+)" />
                                <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFit}" ToolTip="Fit to window (0)" Command="{Binding FitCommand}" AutomationProperties.Name="Fit to window (0)" />
                                <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource IconCompare}" ToolTip="Compare with the next picture side by side (Esc to close)" IsChecked="{Binding IsCompare, Mode=OneWay}" Command="{Binding CompareCommand}" AutomationProperties.Name="Compare side by side" />
                                <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource IconShuffle}" ToolTip="Shuffle slideshow order" IsChecked="{Binding IsShuffle, Mode=OneWay}" Command="{Binding ToggleShuffleCommand}" AutomationProperties.Name="Shuffle slideshow" />
                            </StackPanel>
                        </Border>
            <TextBlock Text="{Binding ErrorText}" Visibility="{Binding HasError, Converter={StaticResource B2V}}" Foreground="{DynamicResource SubtleTextBrush}"
                       FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center" />
                        <Grid x:Name="GalleryArea" Visibility="{Binding IsGallery, Converter={StaticResource B2V}}">
                            <Grid.RowDefinitions><RowDefinition Height="Auto" /><RowDefinition Height="*" /></Grid.RowDefinitions>
                            <!-- Folders inside this folder, with an Up button: lets you move around a drive or folder tree -->
                            <Border Grid.Row="0" Padding="14,12,14,2" Visibility="{Binding ShowFolderStrip, Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <DockPanel Margin="0,0,0,8">
                                        <Button DockPanel.Dock="Left" Style="{StaticResource StatusButton}" Tag="{StaticResource IconUp}" Content="Up" Command="{Binding GoUpCommand}" Margin="0,0,10,0" ToolTip="Go to the parent folder" AutomationProperties.Name="Up one folder" />
                                        <TextBlock Text="{Binding FolderDisplay}" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />
                                    </DockPanel>
                                    <ScrollViewer MaxHeight="124" VerticalScrollBarVisibility="Auto" Focusable="False" Visibility="{Binding ShowFolderChips, Converter={StaticResource B2V}}">
                                        <ItemsControl ItemsSource="{Binding SubFolders}">
                                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate>
                                                    <Button Style="{StaticResource FolderChip}" Tag="{StaticResource IconFolder}" Content="{Binding Name}" ToolTip="{Binding Path}"
                                                            Command="{Binding DataContext.OpenFolderPathCommand, RelativeSource={RelativeSource AncestorType=Window}}" CommandParameter="{Binding Path}" />
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="GalleryList" Grid.Row="1" ItemsSource="{Binding Gallery.Rows}" 
                     Background="Transparent" BorderThickness="0" Padding="10,8" Focusable="False" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                        <TextBlock Text="{Binding Header}" Visibility="{Binding HasHeader, Converter={StaticResource B2V}}" FontSize="15" FontWeight="SemiBold" Margin="8,16,0,6" Foreground="{DynamicResource AccentBrush}" />
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tile" Margin="2" Padding="6" CornerRadius="8" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                                            Width="{Binding DataContext.Gallery.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Height="{Binding DataContext.Gallery.TileHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            MouseLeftButtonDown="Tile_MouseLeftButtonDown" ToolTip="{Binding File.Path}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2" />
                                                <Border Width="30" Height="30" CornerRadius="15" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding ShowPlayBadge, Converter={StaticResource B2V}}">
                                    <Viewbox Width="14" Height="14" Margin="2,0,0,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconPlay}" Fill="White" /></Canvas></Viewbox>
                                </Border>

                                                    <CheckBox Style="{StaticResource ThumbCheck}" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="6,6,0,0" Focusable="False" ToolTip="Select this file (Ctrl+A selects all)" Panel.ZIndex="5"
                                          AutomationProperties.Name="Select file" />
                                                    <TextBlock Text="VIDEO" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding ShowVideoLabel}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="Cannot preview" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding Failed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,6,2,0" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SubtleTextBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
                        </Grid>
                        <v:VideoPlayerView DataContext="{Binding Video}" Visibility="{Binding DataContext.IsVideo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}" />
                        <StackPanel VerticalAlignment="Bottom" HorizontalAlignment="Center" Margin="0,0,0,60" Visibility="{Binding ShowEmptyState, Converter={StaticResource B2V}}">
                            <TextBlock Text="Feather View" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" />
                            <TextBlock Text="{Binding EmptyMessage}" Margin="0,6,0,18" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="420" />
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                                <Button Content="Show pictures from all subfolders" Command="{Binding ToggleSubfoldersCommand}" Margin="0,0,8,0">
                                    <Button.Style>
                                        <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                            <Setter Property="Visibility" Value="Collapsed" />
                                            <Style.Triggers>
                                                <MultiDataTrigger>
                                                    <MultiDataTrigger.Conditions>
                                                        <Condition Binding="{Binding ShowFolderChips}" Value="True" />
                                                        <Condition Binding="{Binding HasSubFolders}" Value="True" />
                                                    </MultiDataTrigger.Conditions>
                                                    <Setter Property="Visibility" Value="Visible" />
                                                </MultiDataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </Button.Style>
                                </Button>
                                <Button Content="Open file" Style="{StaticResource PrimaryButton}" Command="{Binding OpenFileCommand}" Margin="0,0,8,0" />
                                <Button Content="Open folder" Style="{StaticResource TextButton}" Command="{Binding OpenFolderCommand}" />
                            </StackPanel>
                        </StackPanel>
                    </Grid>
                </Border>
            </Grid>

            <!-- Details panel: next to the picture, never on top of it (native video windows cannot be overlapped) -->
            <Border Grid.Column="2" Width="318" Margin="10,4,0,0" CornerRadius="12" Background="{DynamicResource SurfaceBrush}">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowInfo}" Value="True" />
                                    <Condition Binding="{Binding IsGallery}" Value="False" />
                                    <Condition Binding="{Binding ShowChrome}" Value="True" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel>
                    <Grid DockPanel.Dock="Top" Margin="18,10,8,6">
                        <TextBlock Text="Details" FontSize="16" FontWeight="SemiBold" VerticalAlignment="Center" />
                        <Button HorizontalAlignment="Right" Style="{StaticResource IconButton}" Tag="{StaticResource IconClose}" ToolTip="Close details" Command="{Binding ToggleInfoCommand}" AutomationProperties.Name="Close details" />
                    </Grid>
                    <ScrollViewer VerticalScrollBarVisibility="Auto" Padding="14,4,8,14">
                        <StackPanel>
                            <StackPanel Margin="4,0,4,14">
                                <Border CornerRadius="6" ClipToBounds="True" HorizontalAlignment="Left" MaxWidth="180" MaxHeight="100" Margin="0,0,0,10">
                                    <Image Source="{Binding Gallery.Selected.Thumbnail}" Stretch="Uniform" />
                                </Border>
                                <TextBlock Text="{Binding InfoTitle}" FontSize="15" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding InfoSubtitle}" Margin="0,3,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                <TextBlock Text="{Binding InfoDimensions}" Margin="0,2,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                <Button Content="Show in Explorer" Style="{StaticResource TextButton}" Command="{Binding ShowInExplorerCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,10,0,0" />
                            </StackPanel>

                            <Expander Header="Details" Style="{StaticResource SectionExpander}" IsExpanded="{Binding ExpandDetails, Mode=TwoWay}">
                                <ItemsControl ItemsSource="{Binding Info}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Grid Margin="0,0,0,7">
                                                <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SubtleTextBrush}" />
                                                <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                            </Grid>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </Expander>

                            <Expander Header="Camera" Style="{StaticResource SectionExpander}" IsExpanded="{Binding ExpandCamera, Mode=TwoWay}" Visibility="{Binding HasCameraCard, Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding CameraSummary}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <ItemsControl ItemsSource="{Binding TakenLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal" Margin="0,0,0,6">
                                                    <Viewbox Width="16" Height="16" VerticalAlignment="Top" Margin="0,1,10,0">
                                                        <Canvas Width="24" Height="24">
                                                            <Path StrokeThickness="2" Stroke="{DynamicResource SubtleTextBrush}" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round">
                                                                <Path.Style>
                                                                    <Style TargetType="Path">
                                                                        <Setter Property="Data" Value="{StaticResource IconCalendar}" />
                                                                        <Style.Triggers>
                                                                            <DataTrigger Binding="{Binding Label}" Value="Camera"><Setter Property="Data" Value="{StaticResource IconCamera}" /></DataTrigger>
                                                                            <DataTrigger Binding="{Binding Label}" Value="Lens"><Setter Property="Data" Value="{StaticResource IconLens}" /></DataTrigger>
                                                                        </Style.Triggers>
                                                                    </Style>
                                                                </Path.Style>
                                                            </Path>
                                                        </Canvas>
                                                    </Viewbox>
                                                    <TextBlock Text="{Binding Value}" TextWrapping="Wrap" MaxWidth="230" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Location" Style="{StaticResource SectionExpander}" IsExpanded="{Binding ExpandLocation, Mode=TwoWay}" Visibility="{Binding HasLocation, Converter={StaticResource B2V}}">
                                <StackPanel>
                                    <TextBlock Text="{Binding LocationText}" TextWrapping="Wrap" />
                                    <TextBlock Text="Stored in the picture. Nothing is sent anywhere unless you open the map." FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,4,0,8" />
                                    <Button Content="Open map in browser" Style="{StaticResource TextButton}" Command="{Binding OpenLocationCommand}" HorizontalAlignment="Left" Padding="12,5" />
                                </StackPanel>
                            </Expander>

                            <Expander Header="EXIF Data" Style="{StaticResource SectionExpander}" IsExpanded="{Binding ExpandExif, Mode=TwoWay}">
                                <StackPanel>
                                    <ItemsControl ItemsSource="{Binding ExifLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="104" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                                    <TextBlock Text="{Binding Label}" Foreground="{DynamicResource SubtleTextBrush}" />
                                                    <TextBlock Grid.Column="1" Text="{Binding Value}" TextWrapping="Wrap" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                    <TextBlock Text="No camera details are stored in this file." Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding HasExif}" Value="False"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Histogram" Style="{StaticResource SectionExpander}" IsExpanded="{Binding ExpandHistogram, Mode=TwoWay}">
                                <StackPanel>
                                    <Border Background="{DynamicResource SurfaceBrush}" CornerRadius="8" Height="130" Padding="6">
                                        <Grid>
                                            <Path Data="{Binding Histogram.Luma}" Fill="#44FFFFFF" Stretch="Fill" />
                                            <Path Data="{Binding Histogram.Red}" Fill="#55FF4D4D" Stretch="Fill" />
                                            <Path Data="{Binding Histogram.Green}" Fill="#5547D16B" Stretch="Fill" />
                                            <Path Data="{Binding Histogram.Blue}" Fill="#554D8DFF" Stretch="Fill" />
                                        </Grid>
                                    </Border>
                                    <Grid Margin="2,6,2,0"><TextBlock Text="Dark" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" /><TextBlock Text="Light" FontSize="11" HorizontalAlignment="Right" Foreground="{DynamicResource SubtleTextBrush}" /></Grid>
                                </StackPanel>
                            </Expander>

                            <Expander Header="Text in picture" Style="{StaticResource SectionExpander}" IsExpanded="{Binding ExpandText, Mode=TwoWay}">
                                <StackPanel>
                                    <TextBlock Text="Finds printed text with Windows' built-in recognizer. It works offline and only when you click." FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" Margin="0,0,0,8" />
                                    <Button Content="Extract text" Style="{StaticResource TextButton}" Command="{Binding ExtractTextCommand}" HorizontalAlignment="Left" Padding="12,5" />
                                    <TextBlock Text="{Binding OcrStatus}" TextWrapping="Wrap" Margin="0,8,0,0" Foreground="{DynamicResource SubtleTextBrush}" />
                                    <TextBox Text="{Binding OcrText, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" AcceptsReturn="True" MaxHeight="170" VerticalScrollBarVisibility="Auto" Padding="8,6" Margin="0,8,0,0"
                                             Visibility="{Binding HasOcrText, Converter={StaticResource B2V}}" AutomationProperties.Name="Recognized text" />
                                    <Button Content="Copy text" Style="{StaticResource TextButton}" Command="{Binding CopyOcrTextCommand}" HorizontalAlignment="Left" Padding="12,5" Margin="0,8,0,0" Visibility="{Binding HasOcrText, Converter={StaticResource B2V}}" />
                                </StackPanel>
                            </Expander>
                        </StackPanel>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>

        <!-- Filmstrip -->
        <Grid Grid.Row="2" Height="118" Margin="10,10,10,0" Visibility="{Binding FilmstripVisible, Converter={StaticResource B2V}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Button Grid.Column="0" Style="{StaticResource IconButton}" Tag="{StaticResource IconPrev}" ToolTip="Scroll left" Click="FilmLeft_Click" AutomationProperties.Name="Scroll thumbnails left" />
            <ListBox x:Name="FilmList" Grid.Column="1" ItemsSource="{Binding Gallery.Items}" SelectedItem="{Binding Gallery.Selected, Mode=OneWay}" Background="Transparent" BorderThickness="0" Focusable="False"
                     ScrollViewer.VerticalScrollBarVisibility="Disabled" ScrollViewer.HorizontalScrollBarVisibility="Hidden" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate><VirtualizingStackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value><ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate></Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border x:Name="Film" Width="132" Height="104" Margin="4,0" Padding="3" CornerRadius="9" BorderThickness="2" BorderBrush="Transparent" Background="{DynamicResource SurfaceBrush}"
                                MouseLeftButtonDown="FilmItem_MouseLeftButtonDown" ToolTip="{Binding Name}">
                            <Grid>
                                <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality" />
                                <Border Width="30" Height="30" CornerRadius="15" Background="#99000000" HorizontalAlignment="Center" VerticalAlignment="Center" IsHitTestVisible="False"
                                        Visibility="{Binding ShowPlayBadge, Converter={StaticResource B2V}}">
                                    <Viewbox Width="14" Height="14" Margin="2,0,0,0"><Canvas Width="24" Height="24"><Path Data="{StaticResource IconPlay}" Fill="White" /></Canvas></Viewbox>
                                </Border>

                                <CheckBox Style="{StaticResource ThumbCheck}" IsChecked="{Binding IsChecked}" HorizontalAlignment="Left" VerticalAlignment="Top" Margin="4,4,0,0" Focusable="False" ToolTip="Select this file (Ctrl+A selects all)" Panel.ZIndex="5"
                                          AutomationProperties.Name="Select file" />
                                <TextBlock Text="VIDEO" FontSize="11" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}"><Setter Property="Visibility" Value="Collapsed" /><Style.Triggers><DataTrigger Binding="{Binding ShowVideoLabel}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers></Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </Grid>
                        </Border>
                        <DataTemplate.Triggers>
                            <DataTrigger Binding="{Binding IsSelected}" Value="True"><Setter TargetName="Film" Property="BorderBrush" Value="{DynamicResource AccentBrush}" /></DataTrigger>
                        </DataTemplate.Triggers>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <Button Grid.Column="2" Style="{StaticResource IconButton}" Tag="{StaticResource IconNext}" ToolTip="Scroll right" Click="FilmRight_Click" AutomationProperties.Name="Scroll thumbnails right" />
        </Grid>

        <!-- Status bar -->
        <Border Grid.Row="3" Margin="10,10,10,10" Height="44" CornerRadius="12" Background="{DynamicResource SurfaceBrush}" Visibility="{Binding ShowChrome, Converter={StaticResource B2V}}">
            <Grid Margin="16,0,8,0">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding ItemCountText}" Foreground="{DynamicResource SubtleTextBrush}" />
                    <TextBlock Text="  •  " Foreground="{DynamicResource SubtleTextBrush}" />
                    <TextBlock Text="{Binding SelectedCountText}" Foreground="{DynamicResource SubtleTextBrush}" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Style="{StaticResource StatusButton}" Tag="{StaticResource IconMonitor}" Content="Set as Wallpaper" Command="{Binding SetWallpaperCommand}" AutomationProperties.Name="Set as Wallpaper" />
                    <Button Style="{StaticResource StatusButton}" Tag="{StaticResource IconPrinter}" Content="Print" Command="{Binding PrintCommand}" AutomationProperties.Name="Print" />
                    <Button Style="{StaticResource StatusButton}" Tag="{StaticResource IconFolder}" Content="Open Folder" Command="{Binding ShowInExplorerCommand}" AutomationProperties.Name="Open Folder" />
                    <Rectangle Width="1" Margin="8,8" Fill="{DynamicResource BorderBrushSoft}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFullscreen}" ToolTip="Full screen (F11)" Command="{Binding ToggleFullscreenCommand}" AutomationProperties.Name="Full screen" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
