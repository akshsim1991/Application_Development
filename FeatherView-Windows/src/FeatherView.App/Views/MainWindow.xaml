<Window x:Class="FeatherView.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:c="clr-namespace:FeatherView.Controls"
        xmlns:v="clr-namespace:FeatherView.Views"
        Title="Feather View" Width="1100" Height="720" MinWidth="880" MinHeight="420"
        Background="{DynamicResource BgBrush}" AllowDrop="True" UseLayoutRounding="True"
        TextOptions.TextFormattingMode="Ideal" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
    </Window.Resources>
    <Window.InputBindings>
        <KeyBinding Key="Right" Command="{Binding NextCommand}" />
        <KeyBinding Key="Left" Command="{Binding PrevCommand}" />
        <KeyBinding Key="Down" Command="{Binding DownCommand}" />
        <KeyBinding Key="Up" Command="{Binding UpCommand}" />
        <KeyBinding Key="PageDown" Command="{Binding NextFileCommand}" />
        <KeyBinding Key="PageUp" Command="{Binding PrevFileCommand}" />
        <KeyBinding Key="Space" Command="{Binding SpaceCommand}" />
        <KeyBinding Key="Back" Command="{Binding PrevCommand}" />
        <KeyBinding Key="Left" Modifiers="Ctrl" Command="{Binding SeekLongBackCommand}" />
        <KeyBinding Key="Right" Modifiers="Ctrl" Command="{Binding SeekLongForwardCommand}" />
        <KeyBinding Key="OemComma" Command="{Binding Video.FrameBackCommand}" />
        <KeyBinding Key="OemPeriod" Command="{Binding Video.FrameForwardCommand}" />
        <KeyBinding Key="OemOpenBrackets" Command="{Binding Video.SpeedDownCommand}" />
        <KeyBinding Key="OemCloseBrackets" Command="{Binding Video.SpeedUpCommand}" />
        <KeyBinding Key="M" Command="{Binding Video.MuteCommand}" />
        <KeyBinding Key="A" Command="{Binding Video.AbLoopCommand}" />
        <KeyBinding Key="S" Modifiers="Ctrl" Command="{Binding Video.ScreenshotCommand}" />
        <KeyBinding Key="T" Modifiers="Ctrl" Command="{Binding Video.GoToTimeCommand}" />
        <KeyBinding Key="L" Modifiers="Ctrl" Command="{Binding Video.LoopCommand}" />
        <KeyBinding Key="PageDown" Modifiers="Ctrl" Command="{Binding Video.ChapterNextCommand}" />
        <KeyBinding Key="PageUp" Modifiers="Ctrl" Command="{Binding Video.ChapterPreviousCommand}" />
        <KeyBinding Key="Home" Command="{Binding FirstCommand}" />
        <KeyBinding Key="End" Command="{Binding LastCommand}" />
        <KeyBinding Key="Return" Command="{Binding OpenSelectedCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
        <KeyBinding Key="F11" Command="{Binding ToggleFullscreenCommand}" />
        <KeyBinding Key="F" Command="{Binding ToggleFullscreenCommand}" />
        <KeyBinding Key="G" Command="{Binding ToggleGalleryCommand}" />
        <KeyBinding Key="S" Command="{Binding ToggleSlideshowCommand}" />
        <KeyBinding Key="I" Command="{Binding ToggleInfoCommand}" />
        <KeyBinding Key="R" Command="{Binding RotateRightCommand}" />
        <KeyBinding Key="R" Modifiers="Shift" Command="{Binding RotateLeftCommand}" />
        <KeyBinding Key="L" Command="{Binding RotateLeftCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteCommand}" />
        <KeyBinding Key="F5" Command="{Binding ReloadCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl" Command="{Binding OpenFileCommand}" />
        <KeyBinding Key="O" Modifiers="Ctrl+Shift" Command="{Binding OpenFolderCommand}" />
        <KeyBinding Key="C" Modifiers="Ctrl" Command="{Binding CopyCommand}" />
        <KeyBinding Key="OemComma" Modifiers="Ctrl" Command="{Binding SettingsCommand}" />
        <KeyBinding Key="OemPlus" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="Add" Command="{Binding ZoomInCommand}" />
        <KeyBinding Key="OemMinus" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="Subtract" Command="{Binding ZoomOutCommand}" />
        <KeyBinding Key="D0" Command="{Binding FitCommand}" />
        <KeyBinding Key="NumPad0" Command="{Binding FitCommand}" />
        <KeyBinding Key="D1" Command="{Binding ActualSizeCommand}" />
        <KeyBinding Key="NumPad1" Command="{Binding ActualSizeCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Toolbar: icon-only with tooltips; hidden in full screen so the picture gets all the space. -->
        <Border Grid.Row="0" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}"
                BorderThickness="0,0,0,1" Padding="8,5" Visibility="{Binding ShowChrome, Converter={StaticResource B2V}}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFile}" ToolTip="Open file (Ctrl+O)" Command="{Binding OpenFileCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFolder}" ToolTip="Open folder (Ctrl+Shift+O)" Command="{Binding OpenFolderCommand}" />
                    <Button x:Name="RecentButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconClock}" ToolTip="Recent files" Click="RecentButton_Click">
                        <Button.ContextMenu>
                            <ContextMenu ItemsSource="{Binding RecentFiles}">
                                <ContextMenu.ItemContainerStyle>
                                    <Style TargetType="MenuItem">
                                        <Setter Property="Header" Value="{Binding}" />
                                        <Setter Property="Command" Value="{Binding DataContext.OpenRecentCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                                        <Setter Property="CommandParameter" Value="{Binding}" />
                                    </Style>
                                </ContextMenu.ItemContainerStyle>
                            </ContextMenu>
                        </Button.ContextMenu>
                    </Button>
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}" />
                    <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource IconGrid}" ToolTip="Thumbnail gallery (G)"
                                  IsChecked="{Binding IsGallery, Mode=OneWay}" Command="{Binding ToggleGalleryCommand}" />
                </StackPanel>

                <TextBlock Grid.Column="1" Text="{Binding StatusText}" Margin="14,0" VerticalAlignment="Center" HorizontalAlignment="Center"
                           Foreground="{DynamicResource SubtleTextBrush}" TextTrimming="CharacterEllipsis" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconPrev}" ToolTip="Previous (Left)" Command="{Binding PrevCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconNext}" ToolTip="Next (Right)" Command="{Binding NextCommand}" />
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconZoomOut}" ToolTip="Zoom out (-)" Command="{Binding ZoomOutCommand}" />
                    <TextBlock Text="{Binding ZoomText}" Width="44" TextAlignment="Center" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconZoomIn}" ToolTip="Zoom in (+)" Command="{Binding ZoomInCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFit}" ToolTip="Fit to window (0)" Command="{Binding FitCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconActual}" ToolTip="Actual size (1)" Command="{Binding ActualSizeCommand}" />
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconRotateLeft}" ToolTip="Rotate left (L)" Command="{Binding RotateLeftCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconRotateRight}" ToolTip="Rotate right (R)" Command="{Binding RotateRightCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFlip}" ToolTip="Flip horizontally" Command="{Binding FlipCommand}" />
                    <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}" />
                    <Button ToolTip="Slideshow (S)" Command="{Binding ToggleSlideshowCommand}">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                <Setter Property="Tag" Value="{StaticResource IconPlay}" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSlideshow}" Value="True">
                                        <Setter Property="Tag" Value="{StaticResource IconPause}" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource IconInfo}" ToolTip="Details (I)" IsChecked="{Binding ShowInfo}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCopy}" ToolTip="Copy image (Ctrl+C)" Command="{Binding CopyCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconTrash}" ToolTip="Delete to Recycle Bin (Del)" Command="{Binding DeleteCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFullscreen}" ToolTip="Full screen (F11)" Command="{Binding ToggleFullscreenCommand}" />
                    <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconSettings}" ToolTip="Settings (Ctrl+,)" Command="{Binding SettingsCommand}" />
                </StackPanel>
            </Grid>
        </Border>

        <Grid Grid.Row="1">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <Grid Grid.Column="0">
            <!-- Photo mode -->
            <c:ZoomPanImage x:Name="Viewer" Source="{Binding CurrentImage}" ImageId="{Binding ImageId}" FitOnOpen="{Binding Settings.FitOnOpen}"
                            Visibility="{Binding IsPhoto, Converter={StaticResource B2V}}" />
            <TextBlock Text="{Binding ErrorText}" Visibility="{Binding HasError, Converter={StaticResource B2V}}" Foreground="{DynamicResource SubtleTextBrush}"
                       FontSize="15" TextWrapping="Wrap" TextAlignment="Center" MaxWidth="460" VerticalAlignment="Center" HorizontalAlignment="Center" />

            <!-- Gallery mode: rows of tiles inside a virtualizing list, so only visible rows exist. -->
            <ListBox x:Name="GalleryList" ItemsSource="{Binding Gallery.Rows}" Visibility="{Binding IsGallery, Converter={StaticResource B2V}}"
                     Background="Transparent" BorderThickness="0" Padding="10,8" Focusable="False" SelectionMode="Single"
                     ScrollViewer.HorizontalScrollBarVisibility="Disabled" ScrollViewer.CanContentScroll="True"
                     VirtualizingPanel.IsVirtualizing="True" VirtualizingPanel.VirtualizationMode="Recycling" VirtualizingPanel.ScrollUnit="Pixel">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="Focusable" Value="False" />
                        <Setter Property="Template">
                            <Setter.Value>
                                <ControlTemplate TargetType="ListBoxItem"><ContentPresenter /></ControlTemplate>
                            </Setter.Value>
                        </Setter>
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <ItemsControl ItemsSource="{Binding Items}" Focusable="False">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><StackPanel Orientation="Horizontal" /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border x:Name="Tile" Margin="2" Padding="6" CornerRadius="8" Background="Transparent" BorderThickness="2" BorderBrush="Transparent"
                                            Width="{Binding DataContext.Gallery.TileWidth, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            Height="{Binding DataContext.Gallery.TileHeight, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                            MouseLeftButtonDown="Tile_MouseLeftButtonDown" ToolTip="{Binding Name}">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>
                                            <Border CornerRadius="6" Background="{DynamicResource SurfaceBrush}">
                                                <Grid>
                                                    <Image Source="{Binding Thumbnail}" Stretch="Uniform" RenderOptions.BitmapScalingMode="HighQuality" Margin="2" />
                                                    <TextBlock Text="VIDEO" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" FontWeight="SemiBold" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding IsVideo}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Text="Cannot preview" Foreground="{DynamicResource SubtleTextBrush}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock" BasedOn="{StaticResource {x:Type TextBlock}}">
                                                                <Setter Property="Visibility" Value="Collapsed" />
                                                                <Style.Triggers><DataTrigger Binding="{Binding Failed}" Value="True"><Setter Property="Visibility" Value="Visible" /></DataTrigger></Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                </Grid>
                                            </Border>
                                            <TextBlock Grid.Row="1" Text="{Binding Name}" Margin="2,6,2,0" FontSize="11" TextAlignment="Center" TextTrimming="CharacterEllipsis"
                                                       Foreground="{DynamicResource SubtleTextBrush}" />
                                        </Grid>
                                    </Border>
                                    <DataTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsSelected}" Value="True">
                                            <Setter TargetName="Tile" Property="Background" Value="{DynamicResource AccentSoftBrush}" />
                                            <Setter TargetName="Tile" Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
                                        </DataTrigger>
                                    </DataTemplate.Triggers>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <!-- Video mode -->
            <v:VideoPlayerView DataContext="{Binding Video}" Visibility="{Binding DataContext.IsVideo, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource B2V}}" />

            <!-- Empty state -->
            <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center" Visibility="{Binding ShowEmptyState, Converter={StaticResource B2V}}">
                <TextBlock Text="Feather View" FontSize="30" FontWeight="Light" HorizontalAlignment="Center" />
                <TextBlock Text="Open a photo or a folder, or drop them here." Margin="0,6,0,18" Foreground="{DynamicResource SubtleTextBrush}" HorizontalAlignment="Center" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                    <Button Content="Open file" Style="{StaticResource PrimaryButton}" Command="{Binding OpenFileCommand}" Margin="0,0,8,0" />
                    <Button Content="Open folder" Style="{StaticResource TextButton}" Command="{Binding OpenFolderCommand}" />
                </StackPanel>
            </StackPanel>

          </Grid>
            <!-- Details panel -->
            <Border Grid.Column="1" Width="290" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="1,0,0,0">
                <Border.Style>
                    <Style TargetType="Border">
                        <Setter Property="Visibility" Value="Collapsed" />
                        <Style.Triggers>
                            <MultiDataTrigger>
                                <MultiDataTrigger.Conditions>
                                    <Condition Binding="{Binding ShowInfo}" Value="True" />
                                    <Condition Binding="{Binding IsGallery}" Value="False" />
                                </MultiDataTrigger.Conditions>
                                <Setter Property="Visibility" Value="Visible" />
                            </MultiDataTrigger>
                        </Style.Triggers>
                    </Style>
                </Border.Style>
                <DockPanel Margin="16,14">
                    <TextBlock DockPanel.Dock="Top" Text="Details" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,10" />
                    <Button DockPanel.Dock="Bottom" Content="Show in Explorer" Style="{StaticResource TextButton}" Command="{Binding ShowInExplorerCommand}" Margin="0,10,0,0" />
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding Info}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Margin="0,0,0,10">
                                        <TextBlock Text="{Binding Label}" FontSize="11" Foreground="{DynamicResource SubtleTextBrush}" />
                                        <TextBlock Text="{Binding Value}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </DockPanel>
            </Border>
        </Grid>
    </Grid>
</Window>
