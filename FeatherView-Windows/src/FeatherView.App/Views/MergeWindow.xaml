<Window x:Class="FeatherView.Views.MergeWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Merge videos" Width="600" Height="560" MinWidth="520" MinHeight="460" Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False" WindowStartupLocation="CenterOwner">
    <Window.Resources><BooleanToVisibilityConverter x:Key="B2V" /></Window.Resources>
    <DockPanel Margin="22,18,22,16">
        <TextBlock DockPanel.Dock="Top" Text="Merge videos into one file" FontSize="17" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" Text="{Binding Summary}" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,2,0,10" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <ProgressBar Height="8" Minimum="0" Maximum="1" Value="{Binding Progress}" Visibility="{Binding Running, Converter={StaticResource B2V}}" Margin="0,0,0,8" />
            <TextBlock Text="{Binding Status}" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,10" />
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel merge" Style="{StaticResource TextButton}" Command="{Binding CancelCommand}" Visibility="{Binding Running, Converter={StaticResource B2V}}" Margin="0,0,8,0" />
                <Button Content="Show in Explorer" Style="{StaticResource TextButton}" Click="Show_Click" Visibility="{Binding Done, Converter={StaticResource B2V}}" Margin="0,0,8,0" />
                <Button Content="Play it" Style="{StaticResource TextButton}" Click="Play_Click" Visibility="{Binding Done, Converter={StaticResource B2V}}" Margin="0,0,8,0" />
                <Button x:Name="StartButton" Content="Merge" Style="{StaticResource PrimaryButton}" Command="{Binding StartCommand}" IsEnabled="{Binding CanEdit}" Margin="0,0,8,0" />
                <Button Content="Close" Style="{StaticResource TextButton}" Click="Close_Click" IsCancel="True" />
            </StackPanel>
        </StackPanel>
        <StackPanel DockPanel.Dock="Bottom" Margin="0,10,0,0" IsEnabled="{Binding CanEdit}">
            <TextBlock Text="File name (saved next to the first video; an existing file is never overwritten)" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,4" />
            <TextBox Text="{Binding OutputName, UpdateSourceTrigger=PropertyChanged}" Padding="8,6" />
            <TextBlock Text="{Binding OutputFolder}" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,4,0,8" TextTrimming="CharacterEllipsis" />
            <RadioButton Content="Automatic (no quality loss when the videos match, otherwise they are re-encoded)" IsChecked="True" Margin="0,2" Checked="ModeAuto_Checked" />
            <RadioButton Content="Always re-encode (slower, makes different formats and sizes match)" Margin="0,2" Checked="ModeRe_Checked" />
        </StackPanel>
        <Grid>
            <Grid.ColumnDefinitions><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /></Grid.ColumnDefinitions>
            <ListBox x:Name="List" ItemsSource="{Binding Items}" Background="{DynamicResource SurfaceBrush}" BorderThickness="0" Foreground="{DynamicResource TextBrush}" IsEnabled="{Binding CanEdit}">
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <DockPanel Margin="4,3">
                            <TextBlock DockPanel.Dock="Right" Text="{Binding Size}" Foreground="{DynamicResource SubtleTextBrush}" Margin="12,0,4,0" />
                            <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" />
                        </DockPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
            <StackPanel Grid.Column="1" Margin="10,0,0,0" IsEnabled="{Binding CanEdit}">
                <Button Content="Move up" Style="{StaticResource TextButton}" Click="Up_Click" Margin="0,0,0,6" />
                <Button Content="Move down" Style="{StaticResource TextButton}" Click="Down_Click" Margin="0,0,0,6" />
                <Button Content="Remove" Style="{StaticResource TextButton}" Click="Remove_Click" />
            </StackPanel>
        </Grid>
    </DockPanel>
</Window>
