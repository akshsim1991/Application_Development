<Window x:Class="FeatherView.Views.MessageWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="WidthAndHeight" MaxWidth="460" MinWidth="340" Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,22,24,18">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,8" TextWrapping="Wrap" />
        <TextBlock x:Name="BodyText" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button x:Name="CancelButton" Content="Cancel" Style="{StaticResource TextButton}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button x:Name="OkButton" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
