<Window x:Class="FeatherView.Views.ProgressWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="400" Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,22,24,18">
        <TextBlock x:Name="TitleText" FontSize="15" FontWeight="SemiBold" Margin="0,0,0,14" />
        <ProgressBar x:Name="Bar" Height="6" Minimum="0" Maximum="1" />
        <Button Content="Cancel" Style="{StaticResource TextButton}" HorizontalAlignment="Right" Margin="0,18,0,0" Click="Cancel_Click" />
    </StackPanel>
</Window>
