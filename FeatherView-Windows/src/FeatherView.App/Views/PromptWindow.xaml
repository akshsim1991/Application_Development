<Window x:Class="FeatherView.Views.PromptWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        SizeToContent="Height" Width="380" Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,22,24,18">
        <TextBlock x:Name="TitleText" FontSize="16" FontWeight="SemiBold" Margin="0,0,0,6" />
        <TextBlock x:Name="BodyText" Foreground="{DynamicResource SubtleTextBrush}" Margin="0,0,0,10" TextWrapping="Wrap" />
        <TextBox x:Name="Input" Padding="8,6" FontSize="14" />
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" Style="{StaticResource TextButton}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
            <Button Content="OK" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Ok_Click" />
        </StackPanel>
    </StackPanel>
</Window>
