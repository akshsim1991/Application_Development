<Window x:Class="FeatherView.Views.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:s="clr-namespace:FeatherView.Services"
        Title="Settings" Width="640" Height="700" MinHeight="420" Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13"
        UseLayoutRounding="True" ShowInTaskbar="False" ResizeMode="CanResize" WindowStartupLocation="CenterOwner">
    <Window.Resources>
        <s:EnumEqualsConverter x:Key="EnumEq" />
        <Style TargetType="RadioButton">
            <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
            <Setter Property="Margin" Value="0,3,18,3" />
        </Style>
        <Style x:Key="Value" TargetType="TextBlock">
            <Setter Property="Width" Value="46" /><Setter Property="TextAlignment" Value="Right" />
            <Setter Property="VerticalAlignment" Value="Center" /><Setter Property="Foreground" Value="{DynamicResource SubtleTextBrush}" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="20,12">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Cancel" Style="{StaticResource TextButton}" Margin="0,0,8,0" IsCancel="True" Click="Cancel_Click" />
                <Button Content="Save" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
        <TabControl x:Name="Tabs" Margin="12,8,12,0">
            <TabItem Header="Appearance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="Appearance" Style="{StaticResource SectionTitle}" />
                <WrapPanel>
                    <RadioButton Content="Match Windows" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=System}" />
                    <RadioButton Content="Light" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Light}" />
                    <RadioButton Content="Dark" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Dark}" />
                    <RadioButton Content="AMOLED (pure black)" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Amoled}" />
                    <RadioButton Content="Midnight blue" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Midnight}" />
                    <RadioButton Content="Forest green" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Forest}" />
                    <RadioButton Content="Sepia (warm paper)" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Sepia}" />
                    <RadioButton Content="Glass (translucent, Windows 11)" IsChecked="{Binding Theme, Converter={StaticResource EnumEq}, ConverterParameter=Glass}" />
                </WrapPanel>

                <TextBlock Text="Tabs" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Random colour accent on every tab" IsChecked="{Binding RandomTabColors}" />
                <CheckBox Content="Show tab numbers (1, 2, 3...)" IsChecked="{Binding ShowTabNumbers}" />
                <CheckBox Content="Always show the close button on every tab (off: only on the active or hovered tab)" IsChecked="{Binding ShowTabCloseButton}" />
                <CheckBox Content="Show a speaker icon on a tab that is playing a video" IsChecked="{Binding ShowTabPlayingIcon}" />
                <CheckBox Content="Reopen my tabs when Feather View starts" IsChecked="{Binding RestoreSession}" />
                <CheckBox Content="Keep a video playing when I switch to another tab" IsChecked="{Binding KeepVideoPlayingAcrossTabs}" />
                <TextBlock Text="Sidebar" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Pin the sidebar (off: compact icon bar)" IsChecked="{Binding SidebarPinned}" />
                <CheckBox Content="Show Quick Access folders (Pictures, Videos, Downloads, drives)" IsChecked="{Binding QuickAccessExpanded}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="General">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="General" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Remember window size and position" IsChecked="{Binding RememberWindow}" />
                <CheckBox Content="Reopen my tabs when Feather View starts" IsChecked="{Binding RestoreSession}" />

                <TextBlock Text="Browsing" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Sort files by" Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Name" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Name}" />
                    <RadioButton Content="Date" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Date}" />
                    <RadioButton Content="Size" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Size}" />
                    <RadioButton Content="Type" IsChecked="{Binding Sort, Converter={StaticResource EnumEq}, ConverterParameter=Type}" />
                </StackPanel>
                <CheckBox Content="Newest / largest / Z-A first (descending)" IsChecked="{Binding SortDescending}" />
                <CheckBox IsChecked="{Binding IncludeSubfolders}"><TextBlock TextWrapping="Wrap" Text="Show pictures from all folders underneath when I open a folder or drive (up to 200,000)" /></CheckBox>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding ThumbnailSize, StringFormat={}{0} px}" />
                    <TextBlock Text="Thumbnail size" DockPanel.Dock="Left" Width="130" VerticalAlignment="Center" />
                    <Slider Minimum="96" Maximum="320" TickFrequency="16" IsSnapToTickEnabled="True" Value="{Binding ThumbnailSize}" />
                </DockPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Viewing">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="Photo viewing" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Fit photos to the window when opened" IsChecked="{Binding FitOnOpen}" />
                <CheckBox Content="Ask for confirmation before deleting a file (files always go to the Recycle Bin)" IsChecked="{Binding ConfirmDelete}" />
                <CheckBox Content="Show the details panel when opened" IsChecked="{Binding ShowInfoPanelOnOpen}" />

                <TextBlock Text="Slideshow" Style="{StaticResource SectionTitle}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding SlideshowSeconds, StringFormat={}{0} s}" />
                    <TextBlock Text="Seconds per photo" DockPanel.Dock="Left" Width="130" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="30" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SlideshowSeconds}" />
                </DockPanel>
                <CheckBox Content="Start over after the last photo" IsChecked="{Binding SlideshowLoop}" />
                <CheckBox Content="Shuffle (random order, no repeats until all were shown)" IsChecked="{Binding SlideshowShuffle}" />
                <CheckBox Content="Play in full screen" IsChecked="{Binding SlideshowFullscreen}" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Video">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="Video" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="Playback engine" Margin="0,0,0,2" />
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="Automatic" IsChecked="{Binding VideoEngine, Converter={StaticResource EnumEq}, ConverterParameter=Auto}" />
                    <RadioButton Content="Windows built-in" IsChecked="{Binding VideoEngine, Converter={StaticResource EnumEq}, ConverterParameter=MediaFoundation}" />
                    <RadioButton Content="Extended (libmpv)" IsChecked="{Binding VideoEngine, Converter={StaticResource EnumEq}, ConverterParameter=Mpv}" />
                </StackPanel>
                <TextBlock x:Name="EngineStatus" TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,6" />
                <Button Content="Download extended video support" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Click="InstallEngine_Click" />
                <CheckBox Content="Start playing when a video is opened" IsChecked="{Binding VideoAutoplay}" Margin="0,10,0,0" />
                <CheckBox Content="Resume where I stopped" IsChecked="{Binding VideoResume}" />
                <CheckBox Content="Loop videos" IsChecked="{Binding VideoLoop}" />
                <CheckBox Content="Keep a video playing when I switch to another tab" IsChecked="{Binding KeepVideoPlayingAcrossTabs}" />
                <CheckBox Content="Use hardware decoding when available" IsChecked="{Binding HardwareDecoding}" />
                <DockPanel Margin="0,8,0,4">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding FullscreenControlsHideSeconds, StringFormat={}{0} s}" />
                    <TextBlock Text="Hide full-screen controls after" DockPanel.Dock="Left" Width="190" VerticalAlignment="Center" />
                    <Slider Minimum="2" Maximum="15" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding FullscreenControlsHideSeconds}" />
                </DockPanel>
                <CheckBox Content="Load subtitle files with the same name automatically" IsChecked="{Binding AutoLoadSubtitles}" />
                <DockPanel Margin="0,8,0,0">
                    <TextBlock Text="Preferred subtitle languages" DockPanel.Dock="Left" Width="190" VerticalAlignment="Center" />
                    <TextBox Text="{Binding PreferredSubtitleLanguages}" ToolTip="Comma separated, for example: en,eng" Padding="4,3" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="Preferred audio languages" DockPanel.Dock="Left" Width="190" VerticalAlignment="Center" />
                    <TextBox Text="{Binding PreferredAudioLanguages}" ToolTip="Comma separated, for example: en,eng" Padding="4,3" />
                </DockPanel>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding SubtitleSize}" />
                    <TextBlock Text="Subtitle size" DockPanel.Dock="Left" Width="190" VerticalAlignment="Center" />
                    <Slider Minimum="20" Maximum="120" TickFrequency="2" IsSnapToTickEnabled="True" Value="{Binding SubtitleSize}" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding SubtitleBackgroundOpacity, StringFormat={}{0} %}" />
                    <TextBlock Text="Subtitle background" DockPanel.Dock="Left" Width="190" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="100" TickFrequency="5" IsSnapToTickEnabled="True" Value="{Binding SubtitleBackgroundOpacity}" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding SubtitlePosition}" />
                    <TextBlock Text="Subtitle position (0 top - 100 bottom)" DockPanel.Dock="Left" Width="190" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <Slider Minimum="0" Maximum="100" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding SubtitlePosition}" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock Text="Subtitle colour (hex, e.g. #FFFF00)" DockPanel.Dock="Left" Width="190" TextWrapping="Wrap" VerticalAlignment="Center" />
                    <TextBox Text="{Binding SubtitleColor}" Padding="4,3" MaxLength="7" />
                </DockPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Performance">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="Performance and caching" Style="{StaticResource SectionTitle}" />
                <DockPanel>
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding ThumbnailCacheItems}" />
                    <TextBlock Text="Thumbnails kept in memory" DockPanel.Dock="Left" Width="170" VerticalAlignment="Center" />
                    <Slider Minimum="100" Maximum="2000" TickFrequency="50" IsSnapToTickEnabled="True" Value="{Binding ThumbnailCacheItems}" />
                </DockPanel>
                <DockPanel Margin="0,6,0,0">
                    <TextBlock DockPanel.Dock="Right" Style="{StaticResource Value}" Text="{Binding ThumbnailParallelism}" />
                    <TextBlock Text="Background decoders" DockPanel.Dock="Left" Width="170" VerticalAlignment="Center" />
                    <Slider Minimum="1" Maximum="8" TickFrequency="1" IsSnapToTickEnabled="True" Value="{Binding ThumbnailParallelism}" />
                </DockPanel>

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="Updates">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="Updates" Style="{StaticResource SectionTitle}" />
                <CheckBox Content="Check for updates automatically (every few hours while the app is open)" IsChecked="{Binding AutoUpdateCheck}" />
                <CheckBox Content="Download new versions automatically in the background" IsChecked="{Binding AutoDownloadUpdates}" />
                <CheckBox Content="Install a downloaded version automatically when I close Feather View" IsChecked="{Binding AutoInstallUpdates}" />
                <TextBlock Text="Feather View asks before it downloads anything and verifies every update. It never sends your files or personal data." TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,2,0,8" />
                <Button Content="Check for updates now" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Click="CheckNow_Click" />

                    </StackPanel>
                </ScrollViewer>
            </TabItem>
            <TabItem Header="More">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="20,2,20,20">
                <TextBlock Text="Keyboard shortcuts" Style="{StaticResource SectionTitle}" />
                <TextBlock TextWrapping="Wrap" LineHeight="20" Foreground="{DynamicResource SubtleTextBrush}"
                           Text="Left / Right: previous / next      Home / End: first / last&#10;G: gallery      S: slideshow      I: details      F or F11: full screen&#10;R / L: rotate right / left      + / -: zoom      0: fit      1: actual size&#10;Ctrl+O: open file      Ctrl+Shift+O: open folder      Ctrl+C: copy image&#10;Ctrl+T: new tab      Ctrl+W: close tab      Ctrl+Shift+T: reopen closed tab      Ctrl+Tab: next tab&#10;Del: delete to Recycle Bin      F5: reload folder      Esc: back / exit full screen" />

                <TextBlock Text="File associations" Style="{StaticResource SectionTitle}" />
                <TextBlock Text="The installer adds Feather View to the 'Open with' list. Windows lets only you choose the default app." TextWrapping="Wrap" Foreground="{DynamicResource SubtleTextBrush}" FontSize="12" Margin="0,0,0,8" />
                <Button Content="Open Windows default apps" Style="{StaticResource TextButton}" HorizontalAlignment="Left" Click="DefaultApps_Click" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
