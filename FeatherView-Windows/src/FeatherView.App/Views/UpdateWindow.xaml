<Window x:Class="FeatherView.Views.UpdateWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Update available" SizeToContent="Height" Width="460" Background="{DynamicResource BgBrush}" FontFamily="Segoe UI Variable, Segoe UI" FontSize="13" UseLayoutRounding="True" ShowInTaskbar="False" ResizeMode="NoResize" WindowStartupLocation="CenterOwner">
    <StackPanel Margin="24,22,24,18">
        <TextBlock x:Name="Headline" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock x:Name="Detail" Margin="0,6,0,10" Foreground="{DynamicResource SubtleTextBrush}" TextWrapping="Wrap" />
        <ScrollViewer MaxHeight="150" VerticalScrollBarVisibility="Auto">
            <TextBlock x:Name="Notes" TextWrapping="Wrap" />
        </ScrollViewer>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,22,0,0">
            <Button Content="Skip this version" Style="{StaticResource TextButton}" Margin="0,0,8,0" Click="Skip_Click" />
            <Button Content="Later" Style="{StaticResource TextButton}" Margin="0,0,8,0" IsCancel="True" Click="Later_Click" />
            <Button Content="Update now" Style="{StaticResource PrimaryButton}" IsDefault="True" Click="Now_Click" />
        </StackPanel>
    </StackPanel>
</Window>
