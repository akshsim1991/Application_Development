<UserControl x:Class="FeatherView.Views.VideoPlayerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             Focusable="False">
    <UserControl.Resources>
        <BooleanToVisibilityConverter x:Key="B2V" />
        <Style x:Key="SmallIcon" TargetType="Button" BasedOn="{StaticResource IconButton}" />
    </UserControl.Resources>
    <!-- Native video windows cannot be drawn over by WPF ("airspace"), so nothing overlaps the picture:
         the notice and the controls sit in their own rows below it. -->
    <Grid Background="Black">
        <Grid.RowDefinitions>
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <ContentControl Grid.Row="0" Content="{Binding Surface}" Focusable="False" IsTabStop="False" />

        <Border Grid.Row="1" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="14,8"
                Visibility="{Binding HasNotice, Converter={StaticResource B2V}}">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Get extended video support" Style="{StaticResource PrimaryButton}" Padding="12,5" Margin="12,0,0,0"
                        Command="{Binding InstallEngineCommand}" Visibility="{Binding NoticeCanInstall, Converter={StaticResource B2V}}" />
                <TextBlock Text="{Binding Notice}" TextWrapping="Wrap" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
            </DockPanel>
        </Border>

        <Border Grid.Row="2" Background="{DynamicResource SurfaceBrush}" BorderBrush="{DynamicResource BorderBrushSoft}" BorderThickness="0,1,0,0" Padding="12,6,12,8"
                Visibility="{Binding ControlsVisible, Converter={StaticResource B2V}}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{Binding PositionText}" Width="56" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                    <Slider x:Name="Seek" Grid.Column="1" Minimum="0" Maximum="{Binding Duration}" Value="{Binding Position, Mode=OneWay}"
                            IsMoveToPointEnabled="True" Focusable="False" VerticalAlignment="Center" AutomationProperties.Name="Seek" />
                    <TextBlock Grid.Column="2" Text="{Binding DurationText}" Width="56" TextAlignment="Right" VerticalAlignment="Center" Foreground="{DynamicResource SubtleTextBrush}" />
                </Grid>
                <Grid Margin="0,2,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Orientation="Horizontal">
                        <Button ToolTip="Play / pause (Space)" Command="{Binding PlayPauseCommand}" AutomationProperties.Name="Play or pause">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Tag" Value="{StaticResource IconPlay}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding PlayIconIsPause}" Value="True"><Setter Property="Tag" Value="{StaticResource IconPause}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFrameBack}" ToolTip="Previous frame (,) - needs the extended engine" Command="{Binding FrameBackCommand}" AutomationProperties.Name="Previous frame" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconFrameForward}" ToolTip="Next frame (.) - needs the extended engine" Command="{Binding FrameForwardCommand}" AutomationProperties.Name="Next frame" />
                        <Button x:Name="AbButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconAB}" ToolTip="Repeat A-B (A): set start, set end, clear" Command="{Binding AbLoopCommand}" AutomationProperties.Name="Repeat A to B" />
                        <TextBlock Text="{Binding AbText}" VerticalAlignment="Center" Margin="2,0,8,0" Foreground="{DynamicResource AccentBrush}" FontWeight="SemiBold" />
                    </StackPanel>

                    <TextBlock Grid.Column="1" Text="{Binding StatusMessage}" Visibility="{Binding HasStatusMessage, Converter={StaticResource B2V}}" HorizontalAlignment="Center"
                               VerticalAlignment="Center" Foreground="{DynamicResource AccentBrush}" TextTrimming="CharacterEllipsis" />

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button x:Name="SpeedButton" Content="{Binding SpeedText}" Style="{StaticResource TextButton}" Padding="8,4" MinWidth="48" ToolTip="Playback speed ([ and ])" Click="SpeedButton_Click" AutomationProperties.Name="Playback speed" />
                        <Button x:Name="SubtitleButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconSubtitles}" ToolTip="Subtitles" Click="SubtitleButton_Click" AutomationProperties.Name="Subtitles" />
                        <Button x:Name="AudioButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconAudio}" ToolTip="Audio tracks" Click="AudioButton_Click" AutomationProperties.Name="Audio tracks" />
                        <Button Style="{StaticResource IconButton}" Tag="{StaticResource IconCamera}" ToolTip="Save a screenshot of this frame (Ctrl+S)" Command="{Binding ScreenshotCommand}" AutomationProperties.Name="Screenshot" />
                        <ToggleButton Style="{StaticResource IconToggle}" Tag="{StaticResource IconRepeat}" ToolTip="Loop (Ctrl+L)" IsChecked="{Binding LoopEnabled}" AutomationProperties.Name="Loop" />
                        <Button x:Name="MoreButton" Style="{StaticResource IconButton}" Tag="{StaticResource IconMore}" ToolTip="More: aspect ratio, chapters, go to time, rotate" Click="MoreButton_Click" AutomationProperties.Name="More options" />
                        <Rectangle Width="1" Margin="6,6" Fill="{DynamicResource BorderBrushSoft}" />
                        <Button ToolTip="Mute (M)" Command="{Binding MuteCommand}" AutomationProperties.Name="Mute">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource IconButton}">
                                    <Setter Property="Tag" Value="{StaticResource IconVolume}" />
                                    <Style.Triggers><DataTrigger Binding="{Binding IsMuted}" Value="True"><Setter Property="Tag" Value="{StaticResource IconVolumeMute}" /></DataTrigger></Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <Slider Width="96" Minimum="0" Maximum="{Binding VolumeMax}" Value="{Binding Volume}" VerticalAlignment="Center" Focusable="False" IsMoveToPointEnabled="True"
                                ToolTip="Volume (Up and Down keys or mouse wheel)" AutomationProperties.Name="Volume" />
                    </StackPanel>
                </Grid>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>
