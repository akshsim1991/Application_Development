<Project Sdk="Microsoft.NET.Sdk">
  <!-- PneuSim 3.2 – recovered source (decompiled from the 3.2.0 release, see docs/RECOVERY.md).
       Builds on Windows (Visual Studio 2022 / dotnet build) and on Linux/macOS (reference assemblies). -->
  <PropertyGroup>
    <AssemblyName>PneuSim</AssemblyName>
    <RootNamespace>PneuSim</RootNamespace>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net472</TargetFramework>
    <GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <LangVersion>latest</LangVersion>
    <AllowUnsafeBlocks>true</AllowUnsafeBlocks>
    <ApplicationIcon>app.ico</ApplicationIcon>
    <Nullable>disable</Nullable>
    <!-- Decompiled code: keep the warning list quiet until the clean-up pass. -->
    <NoWarn>$(NoWarn);CS0162;CS0168;CS0169;CS0219;CS0414;CS0649;CS1998;CS8981</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <EmbeddedResource Include="app.ico" LogicalName="app.ico" />
  </ItemGroup>
  <ItemGroup>
    <Reference Include="Microsoft.VisualBasic" />
    <Reference Include="System.Windows.Forms" />
    <Reference Include="System.Drawing" />
    <Reference Include="System.Xml.Linq" />
    <Reference Include="System.Runtime.Serialization" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Microsoft.NETFramework.ReferenceAssemblies" Version="1.0.3" PrivateAssets="all" />
  </ItemGroup>
</Project>
