#include <winver.h>
#include "buildinfo.h"

1 24 "FeatherPDF.manifest"
101 ICON "FeatherPDF.ico"

// Shown in Explorer: right-click FeatherPDF.exe > Properties > Details.
VS_VERSION_INFO VERSIONINFO
FILEVERSION FEATHER_VERSION_NUM
PRODUCTVERSION FEATHER_VERSION_NUM
FILEFLAGSMASK 0x3fL
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "080904b0"
        BEGIN
            VALUE "CompanyName", "Akshaya Simha"
            VALUE "FileDescription", "Feather PDF"
            VALUE "FileVersion", FEATHER_VERSION_STR
            VALUE "InternalName", "FeatherPDF"
            VALUE "LegalCopyright", "Free to use and share"
            VALUE "OriginalFilename", "FeatherPDF.exe"
            VALUE "ProductName", "Feather PDF"
            VALUE "ProductVersion", FEATHER_VERSION_STR
            VALUE "Comments", "Built " FEATHER_BUILD_DATE
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x809, 1200
    END
END
